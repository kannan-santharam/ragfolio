# ============================================================================
# Ragfolio — environment
# `npx ragfolio init` writes this file for you. Nothing here is NEXT_PUBLIC_.
# ============================================================================

# --- Provider: "gemini" (free tier available) or "openai" ---------------------
RAG_PROVIDER=gemini

# Only the key for the chosen provider is required.
# Gemini: https://aistudio.google.com/apikey   OpenAI: https://platform.openai.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: comma-separated allowlist of chat models, tried in order (capable
# first, most-generous-quota last). Unset uses the provider's built-in default.
# Free-tier daily caps differ per model by more than 10x — verify against your key.
# CHAT_MODELS=gemini-flash-latest,gemini-3.1-flash-lite

# --- Supabase (free tier: https://supabase.com/dashboard) ---------------------
# Settings -> API. The service-role key bypasses RLS: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Who this assistant is for ------------------------------------------------
OWNER_NAME=
ASSISTANT_NAME=Assistant
# Optional first-screen copy and up to four suggested questions (comma-separated).
WELCOME_MESSAGE=
SUGGESTED_QUESTIONS=
# Optional extra persona text appended to the system prompt (one paragraph).
PERSONA=

# --- PDF / image parsing ------------------------------------------------------
# rich (default): every PDF page and every image is read by the chat model and
#   transcribed to Markdown (tables as tables, charts as [Figure: …] blocks);
#   the text layer is only a fallback for pages the model could not read.
# auto: economy mode, only pages with images or little text go to the model.
# text: text layer only, no images. Each transcribed page is one model request.
PDF_PARSE_MODE=rich
VISION_MAX_PAGES=20

# --- Trusted origins ----------------------------------------------------------
# Comma-separated origins of YOUR site(s). Visitors arriving through these get
# the preloaded documents, the contact details inside them, and your key.
# Reached from anywhere else the app starts empty, strips phone/email from
# passages, and asks visitors for their own key. List both apex and www.
# Also builds the CSP frame-ancestors header — the browser-enforced half.
TRUSTED_ORIGINS=https://example.com,https://www.example.com,http://localhost:5173

# Set to false to close the public URL entirely (no bring-your-own-key mode).
ALLOW_VISITOR_KEYS=true
# Set to false to leave phone numbers and emails in passages for untrusted visitors.
REDACT_CONTACT_DETAILS=true

# --- Seeding ------------------------------------------------------------------
# `npx ragfolio seed` proves it is you with this token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset means seeding is disabled — writes to the shared namespace fail closed.
SEED_TOKEN=

# --- Rate limiting ------------------------------------------------------------
# Counted against a salted hash of the caller's IP. Optional overrides.
RATE_LIMIT_SALT=
# RATE_LIMIT_CHAT_PER_10MIN=25
# RATE_LIMIT_INGEST_PER_HOUR=10

# --- Langfuse tracing (optional, https://cloud.langfuse.com) -------------------
# Leave blank and tracing is a no-op. Keys and contact details are scrubbed
# before anything leaves for Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Anonymous usage counts (see PRIVACY.md) ----------------------------------
# Sends {version, hashed host, event} once per chat/ingest. Never content, keys,
# session ids or visitor addresses. Fire-and-forget. Set to 1 to opt out.
RAGFOLIO_TELEMETRY_DISABLED=
# RAGFOLIO_TELEMETRY_URL=
# Only the maintainer's receiver sets this:
# RAGFOLIO_TELEMETRY_RECEIVER=
